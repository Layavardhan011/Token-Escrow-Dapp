{
    "name": "cancel_offer_scenario",
    "comment": "Test offer creation followed by offer cancellation and refund back to creator",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "1",
                    "balance": "0"
                },
                "address:alice": {
                    "nonce": "1",
                    "balance": "5,000,000,000,000,000,000"
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "1",
                    "newAddress": "sc:token_escrow"
                }
            ]
        },
        {
            "step": "scDeploy",
            "id": "deploy-escrow",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../output/token-escrow.mxsc.json",
                "arguments": [],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "",
                "logs": [],
                "gas": "*",
                "refund": "*"
            }
        },
        {
            "step": "scCall",
            "id": "alice-create-offer",
            "tx": {
                "from": "address:alice",
                "to": "sc:token_escrow",
                "egldValue": "2,000,000,000,000,000,000",
                "function": "createOffer",
                "arguments": [
                    "address:bob",
                    "str:USDC-123456",
                    "0",
                    "1,000,000,000",
                    "0"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "1"
                ],
                "status": "",
                "logs": "*",
                "gas": "*",
                "refund": "*"
            }
        },
        {
            "step": "checkState",
            "accounts": {
                "address:alice": {
                    "nonce": "2",
                    "balance": "3,000,000,000,000,000,000"
                },
                "sc:token_escrow": {
                    "nonce": "0",
                    "balance": "2,000,000,000,000,000,000",
                    "storage": "*"
                },
                "address:owner": {
                    "nonce": "2",
                    "balance": "0"
                }
            }
        },
        {
            "step": "scCall",
            "id": "alice-cancel-offer",
            "tx": {
                "from": "address:alice",
                "to": "sc:token_escrow",
                "function": "cancelOffer",
                "arguments": [
                    "1"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "",
                "logs": "*",
                "gas": "*",
                "refund": "*"
            }
        },
        {
            "step": "checkState",
            "accounts": {
                "address:alice": {
                    "nonce": "3",
                    "balance": "5,000,000,000,000,000,000"
                },
                "sc:token_escrow": {
                    "nonce": "0",
                    "balance": "0",
                    "storage": "*"
                },
                "address:owner": {
                    "nonce": "2",
                    "balance": "0"
                }
            }
        }
    ]
}
